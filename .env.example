PORT=3000
# Set your local PostgreSQL username and password; URL-encode special characters.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/homemade_beads
# For Docker Desktop, use host.docker.internal instead of localhost in DATABASE_URL.
# Required for signing access tokens: generate a random secret of at least 32 bytes.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=60m
