generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductType {
  CUSTOM_DESIGN
  READY_MADE
}

enum OrderStatus {
  ORDERED
  CREATING
  CREATED
  READY_FOR_COURIER
  PICKED_UP_BY_COURIER
  COMPLETED
}

enum PaymentType {
  CASH_ON_DELIVERY
  CASH_ON_PICKUP
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String  @id @default(uuid())
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  userName     String? @unique @map("user_name")
  email        String  @unique
  passwordHash String  @map("password_hash")
  phone        String?

  country    String?
  address    String?
  postalCode String? @map("postal_code")

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]
  orders   Order[]

  @@map("users")
}

model Category {
  sizes            Json?
  options          Json?
  builderType      String? @map("builder_type")
  // Builder-specific settings, e.g. the jewelry strand silhouette.
  builderConfig    Json?   @map("builder_config")
  // Shared design library: an APPAREL category may use the designs (SubCategories)
  // of another category, so one logo can be offered on hoodies and T-shirts alike.
  designCategoryId String? @map("design_category_id")
  id               String  @id @default(uuid())
  name             String  @unique
  description      String?
  imageKey         String? @map("image_key")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subCategories  SubCategory[]
  products       Product[]
  garments       Garment[]
  designCategory Category?     @relation("CategoryDesignLibrary", fields: [designCategoryId], references: [id], onDelete: SetNull)
  designUsers    Category[]    @relation("CategoryDesignLibrary")

  @@index([designCategoryId])
  @@map("categories")
}

// A blank garment model customers design on, e.g. "Classic Hoodie" in "Hoodies".
model Garment {
  id         String @id @default(uuid())
  categoryId String @map("category_id")

  name        String
  description String?

  // Price of the blank garment in cents; a variant may override it.
  basePrice Int @map("base_price")

  // Product photo shown to customers, and front/back mockups used as the studio canvas.
  imageKey      String? @map("image_key")
  frontImageKey String? @map("front_image_key")
  backImageKey  String? @map("back_image_key")

  // Printable areas as fractions of the mockup, with the real print size for production:
  // { "x": 0.3, "y": 0.28, "width": 0.4, "height": 0.42, "widthCm": 30, "heightCm": 40 }
  frontPrintArea Json? @map("front_print_area")
  backPrintArea  Json? @map("back_print_area")

  // App-drawn fallback until mockups are uploaded, e.g. HOODIE or TSHIRT.
  silhouette String?

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants GarmentVariant[]

  @@index([categoryId])
  @@index([isActive])
  @@map("garments")
}

// One sellable size × colour of a garment, with its own stock.
model GarmentVariant {
  id        String @id @default(uuid())
  garmentId String @map("garment_id")

  size       String
  colorName  String  @map("color_name")
  colorValue String  @map("color_value")
  sku        String? @unique

  stock Int  @default(0)
  // Optional price override in cents, e.g. XL costs more; null uses Garment.basePrice.
  price Int?

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  garment  Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([garmentId, size, colorValue])
  @@index([garmentId])
  @@map("garment_variants")
}

model SubCategory {
  id         String @id @default(uuid())
  categoryId String @map("category_id")

  name             String
  description      String?
  imageKey         String? @map("image_key")
  // Untouched upload kept for production (printing), when imageKey was processed.
  originalImageKey String? @map("original_image_key")

  color String?
  // Free text; apparel designs use ICON, LOGO, LETTERING or ILLUSTRATION.
  type  String?

  // Price stored in cents.
  // Example:
  // 150 = €1.50
  // 1500 = €15.00
  price Int @default(0)

  stock      Int     @default(0)
  // Printed designs are unlimited; physical items (beads, patches) track stock.
  trackStock Boolean @default(true) @map("track_stock")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productItems ProductItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("sub_categories")
}

model Product {
  selectedSize    Json?       @map("selected_size")
  selectedOptions Json?       @map("selected_options")
  // Personalised text on GIFT canvases: [{ id, text, x, y, scale, rotation, color?, font? }].
  textLayers      Json?       @map("text_layers")
  id              String      @id @default(uuid())
  productType     ProductType @default(CUSTOM_DESIGN) @map("product_type")
  stock           Int         @default(0)

  // The garment size × colour an APPAREL design is printed on.
  garmentVariantId String? @map("garment_variant_id")

  // User who created the product.
  // Can be ADMIN or CUSTOMER.
  createdById String @map("created_by_id")

  // Main category of the product.
  // Example: Bracelet, Necklace, Keychain.
  categoryId String @map("category_id")

  name                 String
  description          String?
  imageKey             String? @map("image_key")
  designPreviewKey     String? @map("design_preview_key")
  // Second preview for two-sided designs (APPAREL back).
  backDesignPreviewKey String? @map("back_design_preview_key")

  // Snapshot of the builder base price (e.g. the blank garment) in cents, added to
  // the component total. 0 for jewelry and ready-made products.
  basePrice Int @default(0) @map("base_price")

  // Total number of beads/components used.
  // Calculated from ProductItems.
  //
  // Example:
  // 10 Gold Beads + 15 Red Beads = 25
  itemCount Int @default(0) @map("item_count")

  // Total calculated product price in cents.
  //
  // Example:
  // SUM(ProductItem.quantity * ProductItem.unitPrice)
  price Int @default(0)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy      User            @relation(fields: [createdById], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  garmentVariant GarmentVariant? @relation(fields: [garmentVariantId], references: [id], onDelete: Restrict)

  // A product can contain many different beads/components.
  items ProductItem[]

  orders Order[]

  @@index([createdById])
  @@index([categoryId])
  @@index([garmentVariantId])
  @@index([isActive])
  @@map("products")
}

model ProductItem {
  id String @id @default(uuid())

  // Product this item belongs to.
  productId String @map("product_id")

  // Bead/component selected by the customer.
  subCategoryId String @map("sub_category_id")

  // How many of this bead/component are used.
  //
  // Example:
  // Bead test × 10
  quantity Int

  // Position/order in the jewelry design.
  // Useful for rebuilding the design later.
  position Int?

  // Snapshot of SubCategory.price when
  // the product was created.
  //
  // Example:
  // 150 = €1.50
  unitPrice Int @map("unit_price")

  // Free placement for canvas builders such as APPAREL; null for jewelry strands.
  // x/y are the design centre, normalised 0–1 within the side's print area.
  // Customer-uploaded image for a CUSTOM_UPLOAD design ("Your own design").
  customImageKey String? @map("custom_image_key")

  side     String?
  x        Float?
  y        Float?
  scale    Float?
  rotation Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])

  @@index([productId])
  @@index([subCategoryId])
  @@map("product_items")
}

model Order {
  id String @id @default(uuid())

  // Customer who placed the order.
  userId String @map("user_id")

  // Product being ordered.
  productId String @map("product_id")

  // Human-readable order number.
  // Example: HM-2026-000123
  orderNumber String @unique @map("order_number")

  // Current order status.
  status OrderStatus @default(ORDERED)

  // Payment information.
  paymentType   PaymentType   @map("payment_type")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  // Final order price snapshot in cents.
  //
  // Example:
  // 2999 = €29.99
  totalPrice       Int     @map("total_price")
  // Immutable version of the ordered Product, category and component details.
  designSnapshot   Json?   @map("design_snapshot")
  // Independent R2 copy of the customer's preview at placement time.
  designPreviewKey String? @map("design_preview_key")

  // Delivery information snapshot.
  firstName String @map("first_name")
  lastName  String @map("last_name")
  phone     String

  country    String
  address    String
  postalCode String? @map("postal_code")

  // Optional instructions from customer.
  customerNotes String? @map("customer_notes")

  // Internal notes for admin.
  adminNotes String? @map("admin_notes")

  // Photo of the actual finished product.
  // Later this can contain an S3 object key/URL.
  finalImageUrl String? @map("final_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}
