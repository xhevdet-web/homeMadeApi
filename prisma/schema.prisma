generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

// Who a Product comes from: the admin catalog, or a customer's Creative Studio design.
enum ProductOrigin {
  COMPANY
  CUSTOMER
}

enum OrderStatus {
  ORDERED
  CREATING
  CREATED
  READY_FOR_COURIER
  PICKED_UP_BY_COURIER
  COMPLETED
}

enum PaymentType {
  CASH_ON_DELIVERY
  CASH_ON_PICKUP
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

// How a gift arrives: a see-through container, or a closed one (box, bag) chosen in a colour.
enum GiftPackagingType {
  TRANSPARENT
  OPAQUE
}

// The outline of the packaging: it decides the box drawn in the Gift Studio and the space
// pieces can be arranged in. Square and rectangular boxes are different physical stock.
enum GiftPackagingShape {
  SQUARE
  RECTANGULAR
}

model User {
  id           String  @id @default(uuid())
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  userName     String? @unique @map("user_name")
  email        String  @unique
  passwordHash String  @map("password_hash")
  phone        String?

  country    String?
  address    String?
  postalCode String? @map("postal_code")

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]
  orders   Order[]

  @@map("users")
}

// Organises Products and decides which Creative Studio opens; holds no price or stock.
model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  imageKey    String? @map("image_key")

  // Which Creative Studio designs this category: JEWELRY, BOUQUET, GIFT or APPAREL.
  builderType   String? @map("builder_type")
  // Studio-wide settings, e.g. { "silhouette": "NECKLACE" } or { "silhouette": "HOODIE" }.
  builderConfig Json?   @map("builder_config")
  // Studio size presets for jewelry. A design constraint, not inventory. Length ranges in
  // millimetres: [{ id, name, minMeasurementMm, maxMeasurementMm, defaultMeasurementMm }].
  // Sizes saved before (not yet converted) keep the legacy [{ id, name, measurement, unit,
  // maxItems }] and work as before.
  sizes         Json?

  // Shared design library: a category may also offer the designs (SubCategories) of
  // another category, so one logo can be offered on hoodies and T-shirts alike.
  designCategoryId String? @map("design_category_id")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subCategories  SubCategory[]
  products       Product[]
  designCategory Category?     @relation("CategoryDesignLibrary", fields: [designCategoryId], references: [id], onDelete: SetNull)
  designUsers    Category[]    @relation("CategoryDesignLibrary")

  @@index([designCategoryId])
  @@map("categories")
}

model SubCategory {
  id         String @id @default(uuid())
  categoryId String @map("category_id")

  name             String
  description      String?
  imageKey         String? @map("image_key")
  // Untouched upload kept for production (printing), when imageKey was processed.
  originalImageKey String? @map("original_image_key")

  color String?
  // Free text; apparel designs use ICON, LOGO, LETTERING or ILLUSTRATION.
  type  String?

  // Price stored in cents.
  // Example:
  // 150 = €1.50
  // 1500 = €15.00
  price Int @default(0)

  stock             Int     @default(0)
  // Jewelry components: the length one piece occupies on the cord, in whole millimetres (an
  // 8 mm round bead is 8). Null until the admin enters it; other studios leave it empty.
  effectiveLengthMm Int?    @map("effective_length_mm")
  // Printed designs are unlimited; physical items (beads, patches) track stock.
  trackStock        Boolean @default(true) @map("track_stock")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productItems ProductItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("sub_categories")
}

model Product {
  id     String        @id @default(uuid())
  origin ProductOrigin @default(CUSTOMER)

  // Every Product belongs to exactly one Category.
  categoryId    String  @map("category_id")
  // The admin (COMPANY) or customer (CUSTOMER) who created the product.
  createdById   String  @map("created_by_id")
  // CUSTOMER designs made on a COMPANY product, e.g. a design printed on
  // "Black Essential Hoodie". Null for designs built only from components.
  baseProductId String? @map("base_product_id")

  name                 String
  description          String?
  // Catalog photo; for APPAREL it is also the studio canvas (front).
  imageKey             String? @map("image_key")
  // Optional back canvas for two-sided studios (APPAREL).
  backImageKey         String? @map("back_image_key")
  designPreviewKey     String? @map("design_preview_key")
  // Second preview for two-sided designs (APPAREL back).
  backDesignPreviewKey String? @map("back_design_preview_key")

  // COMPANY apparel: one Product is one colour, e.g. "Black" / "#111111".
  color      String?
  colorHex   String? @map("color_hex")
  // Printable areas as fractions of imageKey/backImageKey, with the real print size:
  // { "front": { x, y, width, height, widthCm?, heightCm? }, "back": { ... } }
  printAreas Json?   @map("print_areas")

  // COMPANY inventory. Sized products track stock per size and leave `stock` at 0:
  // [{ "size": "S", "stock": 20 }, { "size": "M", "stock": 28 }]
  sizes Json?
  stock Int   @default(0)

  // CUSTOMER: the chosen size snapshot, from the base product's sizes or the
  // category's studio size presets, e.g. { "id": "L", "name": "L" }.
  selectedSize Json? @map("selected_size")
  // Personalised text on GIFT canvases: [{ id, text, x, y, scale, rotation, color?, font? }].
  textLayers   Json? @map("text_layers")

  // CUSTOMER: snapshot of the base product's price in cents, added to the component total.
  basePrice Int @default(0) @map("base_price")

  // CUSTOMER GIFT designs: the packaging around the contents and, for closed packaging,
  // its colour. Null for every other studio.
  giftPackagingId      String? @map("gift_packaging_id")
  giftPackagingColorId String? @map("gift_packaging_color_id")
  // Snapshot in cents of the packaging price plus the colour's adjustment, like basePrice.
  packagingPrice       Int     @default(0) @map("packaging_price")

  // Total number of components used, calculated from ProductItems.
  itemCount Int @default(0) @map("item_count")

  // Price in cents. COMPANY: set by the admin. CUSTOMER: basePrice plus packagingPrice
  // plus SUM(ProductItem.quantity * ProductItem.unitPrice).
  price Int @default(0)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy          User                @relation(fields: [createdById], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  baseProduct        Product?            @relation("ProductBase", fields: [baseProductId], references: [id], onDelete: NoAction)
  derivedProducts    Product[]           @relation("ProductBase")
  // Restrict: packaging used by a design is deactivated, never deleted.
  giftPackaging      GiftPackaging?      @relation(fields: [giftPackagingId], references: [id], onDelete: Restrict)
  giftPackagingColor GiftPackagingColor? @relation(fields: [giftPackagingColorId], references: [id], onDelete: Restrict)

  // Components used in a CUSTOMER design.
  items ProductItem[]

  orders Order[]

  @@index([createdById])
  @@index([categoryId, origin])
  @@index([baseProductId])
  @@index([giftPackagingId])
  @@index([giftPackagingColorId])
  @@index([isActive])
  @@map("products")
}

// Packaging a GIFT design arrives in, e.g. "Transparent Box" or "Classic Closed Box". It is
// not a component: it is never placed on the canvas, it surrounds what is.
model GiftPackaging {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  type        GiftPackagingType
  shape       GiftPackagingShape @default(SQUARE)
  imageKey    String?            @map("image_key")

  // Price in cents, e.g. 400 = €4.00.
  price Int @default(0)
  // Inventory of packaging without colours (TRANSPARENT). Packaging with colours keeps
  // its stock per colour instead.
  stock Int @default(0)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  colors   GiftPackagingColor[]
  products Product[]

  @@index([isActive])
  @@map("gift_packaging")
}

// A colour of OPAQUE packaging, e.g. "Pink" / "#E8B4BC", with its own stock.
model GiftPackagingColor {
  id          String  @id @default(uuid())
  packagingId String  @map("packaging_id")
  name        String
  hex         String
  // Optional photo of the packaging in this colour.
  imageKey    String? @map("image_key")

  // Added to the packaging price, in cents.
  priceAdjustment Int @default(0) @map("price_adjustment")
  stock           Int @default(0)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  packaging GiftPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([packagingId, name])
  @@index([packagingId])
  @@map("gift_packaging_colors")
}

model ProductItem {
  id String @id @default(uuid())

  // Product this item belongs to.
  productId String @map("product_id")

  // Bead/component selected by the customer.
  subCategoryId String @map("sub_category_id")

  // How many of this bead/component are used.
  //
  // Example:
  // Bead test × 10
  quantity Int

  // Position/order in the jewelry design.
  // Useful for rebuilding the design later.
  position Int?

  // Snapshot of SubCategory.price when
  // the product was created.
  //
  // Example:
  // 150 = €1.50
  unitPrice Int @map("unit_price")

  // Free placement for canvas builders such as APPAREL; null for jewelry strands.
  // x/y are the design centre, normalised 0–1 within the side's print area.
  // Customer-uploaded image for a CUSTOM_UPLOAD design ("Your own design").
  customImageKey String? @map("custom_image_key")

  side     String?
  x        Float?
  y        Float?
  scale    Float?
  rotation Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])

  @@index([productId])
  @@index([subCategoryId])
  @@map("product_items")
}

model Order {
  id String @id @default(uuid())

  // Customer who placed the order.
  userId String @map("user_id")

  // Product being ordered.
  productId String @map("product_id")

  // Human-readable order number.
  // Example: HM-2026-000123
  orderNumber String @unique @map("order_number")

  // Current order status.
  status OrderStatus @default(ORDERED)

  // Payment information.
  paymentType   PaymentType   @map("payment_type")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  // Final order price snapshot in cents.
  //
  // Example:
  // 2999 = €29.99
  totalPrice       Int     @map("total_price")
  // Immutable version of the ordered Product, category and component details.
  designSnapshot   Json?   @map("design_snapshot")
  // Independent R2 copy of the customer's preview at placement time.
  designPreviewKey String? @map("design_preview_key")

  // Delivery information snapshot.
  firstName String @map("first_name")
  lastName  String @map("last_name")
  phone     String

  country    String
  address    String
  postalCode String? @map("postal_code")

  // Optional instructions from customer.
  customerNotes String? @map("customer_notes")

  // Internal notes for admin.
  adminNotes String? @map("admin_notes")

  // Photo of the actual finished product.
  // Later this can contain an S3 object key/URL.
  finalImageUrl String? @map("final_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}
